{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bloqsync",
  "version": "0.3.1",
  "identifier": "io.github.niemanma.bloqsync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "bloqsync", "width": 960, "height": 700, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Ambient light sync for ROBOBLOQ SyncLight LED bars",
    "longDescription": "Unofficial ambient light sync for ROBOBLOQ SyncLight USB LED bars on Linux/GNOME/Wayland. Screen sync (PipeWire) and an audio-reactive cinema mode for DRM content.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libpulse0",
          "libayatana-appindicator3-1",
          "xdg-desktop-portal",
          "pipewire"
        ],
        "files": {
          "/lib/udev/rules.d/99-bloqsync.rules": "../contrib/99-bloqsync.rules"
        },
        "postInstallScript": "deb/postinst.sh"
      }
    }
  }
}
